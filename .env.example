# String de conexão do MongoDB (obrigatória)
MONGODB_URI=mongodb://127.0.0.1:27017/fluxo

# Duração da sessão em horas (opcional, padrão 12)
SESSION_TTL_HOURS=12

# Nível de log: debug | info | warn | error (opcional, padrão info)
LOG_LEVEL=info

# Cookie de sessão com flag Secure (opcional). Padrão: true em produção, false em desenvolvimento.
# Use false apenas para rodar o build de produção via HTTP (ex.: docker compose local).
# COOKIE_SECURE=false
